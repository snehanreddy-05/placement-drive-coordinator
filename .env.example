# PlacementOS Environment Configuration Template

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME=PlacementOS
VERSION=1.0.0

# Database Connection (SQLite for local, PostgreSQL for production)
DATABASE_URL=sqlite:///./placementos.db
# DATABASE_URL=postgresql://placement_user:placement_password_2026@localhost:5432/placementos_db

# Security & CORS
SECRET_KEY=placementos-enterprise-secret-key-change-in-prod-2026
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM Orchestrator Abstraction
# Options: deterministic (no key required), gemini, openai
LLM_PROVIDER=deterministic
LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your_gemini_or_openai_api_key_here

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
